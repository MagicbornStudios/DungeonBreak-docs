{
  "$schema": "https://dungeonbreak.dev/schemas/spell-categories.schema.json",
  "categories": [
    {
      "name": "Conversation",
      "order": 1,
      "categoryId": "conversation",
      "description": "Unlock or enhance dialogue options. Duration typically 1 encounter."
    },
    {
      "name": "Transportation",
      "order": 2,
      "categoryId": "transportation",
      "description": "Movement speed, teleportation, dungeon traversal."
    },
    {
      "name": "Exploration",
      "order": 3,
      "categoryId": "exploration",
      "description": "Detection, light, traps, mapping."
    },
    {
      "name": "Combat",
      "order": 4,
      "categoryId": "combat",
      "description": "Damage, status, direct conflict."
    },
    {
      "name": "Crafting",
      "order": 5,
      "categoryId": "crafting",
      "description": "Rune forge, evolution, affinity. Used at campfire."
    },
    {
      "name": "Detection",
      "order": 6,
      "categoryId": "detection",
      "description": "Reveal hidden, sense danger, scout."
    }
  ],
  "description": "Spell categories for filter/display. Merges Pokemon-style typing with rune system: conversation, transportation, exploration, combat, crafting, detection.",
  "schemaVersion": "spell-categories.v1"
}
