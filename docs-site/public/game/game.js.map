      "effectId": "effect_haste_dungeon",
      "effectDurationMoves": 999,
      "movementModifier": { "ticksPerMove": 0.5 },
      "visualRef": { "spriteCollection": "pokemon-items", "iconSpriteUrl": "https://raw.githubusercontent.com/MagicbornStudios/sprites/master/sprites/items/poke-ball.png" }
    }
  ]
}
