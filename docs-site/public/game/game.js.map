{
  "$schema": "https://dungeonbreak.dev/schemas/party-roles.schema.json",
  "schemaVersion": "party-roles.v1",
  "description": "Party role = flavor only for dungeoneers (e.g. Jack of all trades). Used in narration/dialogue. Referenced by NPC/player for flavor.",
  "partyRoles": [
    { "partyRoleId": "jack_of_all_trades", "name": "Jack of all trades", "description": "Solo generalist; no fixed role in a party." },
    { "partyRoleId": "tank", "name": "Tank", "description": "Absorbs threat and protects others." },
    { "partyRoleId": "healer", "name": "Healer", "description": "Keeps the party alive." },
    { "partyRoleId": "scout", "name": "Scout", "description": "Leads exploration and awareness." },
    { "partyRoleId": "face", "name": "Face", "description": "Handles dialogue and social encounters." }
  ]
}
