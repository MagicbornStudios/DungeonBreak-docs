{
  "$schema": "https://dungeonbreak.dev/schemas/mounts.schema.json",
  "schemaVersion": "mounts.v1",
  "description": "The single mount Kael starts with. Whistle to call/dismiss; when active, grants movement benefit.",
  "mounts": [
    {
      "mountId": "bear",
