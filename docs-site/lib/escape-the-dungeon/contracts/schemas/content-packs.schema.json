{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungeonbreak.dev/schemas/content-packs.schema.json",
  "title": "DungeonBreak Content Schema Document",
  "type": "object",
  "required": ["schemaVersion", "featureSchema", "modelSchemas"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "featureSchema": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureDefinition"
      }
    },
    "modelSchemas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelSchema"
      }
    },
    "contentBindings": {
      "$ref": "#/$defs/contentBindings"
    }
  },
  "$defs": {
    "featureDefinition": {
      "type": "object",
      "required": ["featureId", "label"],
      "properties": {
        "featureId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "defaultValue": {
          "type": "number",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "modelFeatureRef": {
      "type": "object",
      "required": ["featureId"],
      "properties": {
        "featureId": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "defaultValue": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "statModifierMapping": {
      "type": "object",
      "required": ["modifierFeatureId", "targetFeatureId"],
      "properties": {
        "modifierFeatureId": {
          "type": "string",
          "minLength": 1
        },
        "targetFeatureId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "statModifier": {
      "type": "object",
      "required": ["modifierStatModelId", "mappings"],
      "properties": {
        "modifierStatModelId": {
          "type": "string",
          "minLength": 1
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statModifierMapping"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "modelSchema": {
      "type": "object",
      "required": ["modelId", "label", "featureRefs"],
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "extendsModelId": {
          "type": "string",
          "minLength": 1
        },
        "attachedStatModelIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "statModifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statModifier"
          },
          "default": []
        },
        "featureRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelFeatureRef"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "modelInstanceBinding": {
      "type": "object",
      "required": ["id", "name", "modelId", "canonical"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "contentBindings": {
      "type": "object",
      "properties": {
        "modelInstances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelInstanceBinding"
          },
          "default": []
        },
        "canonicalModelInstances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelInstanceBinding"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
