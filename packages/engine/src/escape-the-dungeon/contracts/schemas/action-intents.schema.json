{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/action-intents.schema.json",
  "title": "ActionIntentsPack",
  "description": "Config: maps action types to UI intent/screen/priority. Referenced by presenter.",
  "type": "object",
  "required": ["intents"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actionType", "uiIntent", "uiScreen"],
        "properties": {
          "actionType": { "type": "string" },
          "uiIntent": { "type": "string" },
          "uiScreen": { "type": "string" },
          "uiPriority": { "type": "integer" }
        }
      }
    }
  }
}
