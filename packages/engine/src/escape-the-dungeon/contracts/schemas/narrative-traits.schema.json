{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/narrative-traits.schema.json",
  "title": "NarrativeTraitsPack",
  "description": "Narrative stat definitions. traitId is the authored content id; entityKey is the plain runtime key used inside an entity's narrativeStats map.",
  "type": "object",
  "required": ["schemaVersion", "traits"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "traits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["traitId", "entityKey", "name"],
        "properties": {
          "traitId": { "type": "string", "pattern": "^trait_" },
          "entityKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "defaultValue": { "type": "number" },
          "hidden": { "type": "boolean", "description": "If true, do not show in UI. Used for internal calculation (e.g. Momentum modulates trait growth)." }
        }
      }
    }
  }
}
