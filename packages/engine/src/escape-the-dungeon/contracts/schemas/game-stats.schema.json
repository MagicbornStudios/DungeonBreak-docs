{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/game-stats.schema.json",
  "title": "GameStatsPack",
  "description": "Core gameplay tuning values shared across engine and UI runtime.",
  "type": "object",
  "required": [
    "schemaVersion",
    "defaultMoveTickCost",
    "preparedSpellSlotCount",
    "runeForgeOfferItemCost",
    "treasureCrystalRewardsByRarity",
    "combatCrystalRewardsByEntityKind",
    "darkMapReputationPenalty",
    "merchantBuyPriceByRarity",
    "merchantSellPriceByRarity",
    "temporaryHostilityDurationTicks",
    "playerStarterSkillIds",
    "playerAuthoredStarterSpellIds"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "defaultMoveTickCost": { "type": "number", "minimum": 0 },
    "preparedSpellSlotCount": { "type": "integer", "minimum": 1 },
    "runeForgeOfferItemCost": { "type": "integer", "minimum": 0 },
    "treasureCrystalRewardsByRarity": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "combatCrystalRewardsByEntityKind": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "darkMapReputationPenalty": { "type": "integer", "minimum": 0 },
    "merchantBuyPriceByRarity": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "merchantSellPriceByRarity": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "temporaryHostilityDurationTicks": {
      "type": "integer",
      "minimum": 1
    },
    "playerStarterSkillIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "playerAuthoredStarterSpellIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
