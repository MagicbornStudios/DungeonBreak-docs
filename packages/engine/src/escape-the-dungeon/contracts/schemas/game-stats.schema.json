{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/game-stats.schema.json",
  "title": "GameStatsPack",
  "description": "Core gameplay tuning values shared across engine and UI runtime.",
  "type": "object",
  "required": [
    "schemaVersion",
    "defaultMoveTickCost",
    "preparedSpellSlotCount",
    "runeForgeOfferItemCost",
    "treasureCrystalRewardsByRarity",
    "combatCrystalRewardsByEntityKind",
    "darkMapReputationPenalty",
    "merchantBuyPriceByRarity",
    "merchantSellPriceByRarity",
    "temporaryHostilityDurationTicks",
    "playerStarterSkillIds",
    "playerAuthoredStarterSpellIds"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "defaultMoveTickCost": { "type": "number", "minimum": 0 },
    "preparedSpellSlotCount": { "type": "integer", "minimum": 1 },
    "runeForgeOfferItemCost": { "type": "integer", "minimum": 0 },
    "treasureCrystalRewardsByRarity": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "combatCrystalRewardsByEntityKind": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "darkMapReputationPenalty": { "type": "integer", "minimum": 0 },
    "merchantBuyPriceByRarity": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "merchantSellPriceByRarity": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "temporaryHostilityDurationTicks": {
      "type": "integer",
      "minimum": 1
    },
    "playerStarterSkillIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "playerAuthoredStarterSpellIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "currencyItemIds": {
      "type": "array",
      "description": "Item ids in itemPack that represent spendable mana crystals / trade currency (typically tagged currency).",
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewPlayableCharacters": {
      "type": "array",
      "description": "Review-hub only: composed character previews (archetype, starters, inventory). Not read by the game engine.",
      "items": {
        "type": "object",
        "required": ["characterId", "label", "archetypeId"],
        "properties": {
          "characterId": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "presetId": { "type": "string" },
          "archetypeId": { "type": "string" },
          "entityTypeId": { "type": "string" },
          "partyRoleId": { "type": "string" },
          "visual": { "type": "object" },
          "overrideStarterSkillIds": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "overrideStarterSpellIds": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "startingInventory": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["itemId", "count"],
              "properties": {
                "itemId": { "type": "string" },
                "count": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
