{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/dialogue.schema.json",
  "title": "DialoguePack",
  "description": "Dialogue pack for the game. Flat list of dialogue entries; content editor uses this schema.",
  "type": "object",
  "required": ["dialogues", "presenterStrings"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "presenterStrings": {
      "$ref": "#/definitions/PresenterStrings"
    },
    "dialogues": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DialogueEntry"
      }
    }
  },
  "definitions": {
    "DialogueEntry": {
      "type": "object",
      "properties": {
        "dialogueId": { "type": "string" },
        "sceneId": { "type": "string" },
        "label": { "type": "string" },
        "line": { "type": "string" },
        "responseText": { "type": "string" },
        "anchorVector": { "type": "object" },
        "radius": { "type": "number" },
        "effectVector": { "type": "object" },
        "requiresRoomFeature": { "type": "string" },
        "requiresItemTagPresent": { "type": "string" },
        "requiresItemTagAbsent": { "type": "string" },
        "requiresSkillId": { "type": "string" },
        "takeItemTag": { "type": "string" },
        "nextDialogueId": { "type": "string" }
      },
      "required": ["dialogueId", "label", "line", "responseText"]
    },
    "PresenterStrings": {
      "type": "object",
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "description": { "type": "string" },
        "actionGroupTitles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "systemActionLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "initialFeed": {
          "type": "object",
          "properties": {
            "boot-1": { "type": "string" },
            "boot-2": { "type": "string" },
            "boot-3Prefix": { "type": "string" },
            "boot-3Suffix": { "type": "string" }
          },
          "required": ["boot-1", "boot-2", "boot-3Prefix", "boot-3Suffix"]
        },
        "templates": {
          "type": "object",
          "properties": {
            "dialogueChoose": { "type": "string" },
            "eventLine": { "type": "string" },
            "warningLine": { "type": "string" }
          },
          "required": ["dialogueChoose", "eventLine", "warningLine"]
        },
        "defaults": {
          "type": "object",
          "properties": {
            "speakIntentText": { "type": "string" },
            "cutsceneTitle": { "type": "string" }
          },
          "required": ["speakIntentText", "cutsceneTitle"]
        }
      },
      "required": [
        "actionGroupTitles",
        "defaults",
        "initialFeed",
        "schemaVersion",
        "systemActionLabels",
        "templates"
      ]
    }
  }
}
