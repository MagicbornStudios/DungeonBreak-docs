{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/spells.schema.json",
  "title": "SpellsPack",
  "description": "Spells: rune-based, with categoryId, rarityId. Optional forgeCostManaCrystals for rune forge creation; if omitted, use default by rarity from spell-forge-costs.",
  "type": "object",
  "required": ["schemaVersion", "spells"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "spells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["spellId", "name", "categoryId", "rarityId"],
        "properties": {
          "spellId": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "categoryId": { "type": "string" },
          "rarityId": { "type": "string" },
          "manaCost": { "type": "number" },
          "forgeCostManaCrystals": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "runeCombo": { "type": "array", "items": { "type": "string" } },
          "power": { "type": "number" },
          "effectIds": { "type": "array", "items": { "type": "string" } },
          "durationTicks": { "type": "integer" }
        }
      }
    }
  }
}
