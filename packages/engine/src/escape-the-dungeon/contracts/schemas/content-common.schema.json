{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "https://dungeonbreak.dev/schemas/content-common.schema.json",
  "title": "ContentCommon",
  "description": "Shared primitives for content-source and content-pack-bundle. Content vectors use authored lookup ids; runtime entity stat maps use plain keys defined by each lookup pack's entityKey field.",
  "definitions": {
    "Vector": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Content-authored stat vectors. Keys are lookup ids from packs such as trait_*, stat_combat_*, and stat_skill_*.",
      "title": "Vector"
    },
    "VectorDelta": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Content-authored stat deltas. Keys are lookup ids from packs such as trait_*, stat_combat_*, and stat_skill_*.",
      "title": "VectorDelta"
    },
    "Vec3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["x", "y", "z"],
      "title": "Vec3"
    },
    "Transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": { "$ref": "#/definitions/Vec3" },
        "rotation": { "$ref": "#/definitions/Vec3" },
        "scale": { "$ref": "#/definitions/Vec3" }
      },
      "required": ["position", "rotation", "scale"],
      "title": "Transform"
    },
    "VisualReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spriteCollection": { "type": "string" },
        "frontSpriteUrl": { "type": "string", "format": "uri" },
        "backSpriteUrl": { "type": "string", "format": "uri" },
        "iconSpriteUrl": { "type": "string", "format": "uri" }
      },
      "required": ["spriteCollection"],
      "title": "VisualReference"
    }
  }
}
