{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/content_items.schema.json",
  "title": "ContentItemsPack",
  "description": "Items for Quaterra. vectorDelta keys are references to lookup packs (trait_*, stat_combat_*). A modifier is a delta.",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "description": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/ContentItem" }
    }
  },
  "definitions": {
    "VectorDelta": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Delta per referenced dimension. Keys = ids from lookup packs (trait_*, stat_combat_*)."
    },
    "ContentItem": {
      "type": "object",
      "required": ["itemId"],
      "properties": {
        "itemId": { "type": "string" },
        "name": { "type": "string" },
        "rarityId": { "type": "string" },
        "equip_slot_id": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "vectorDelta": { "$ref": "#/definitions/VectorDelta" },
        "visual": { "type": "object" }
      }
    }
  }
}
