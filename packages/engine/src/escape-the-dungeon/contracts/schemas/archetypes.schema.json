{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/archetypes.schema.json",
  "title": "ArchetypesPack",
  "description": "Content: archetypes = character builds with a single narrativeProfile plus preferred skills. Referenced by titles and player classification.",
  "type": "object",
  "required": ["archetypes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["archetypeId", "label"],
        "properties": {
          "archetypeId": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "narrativeProfile": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "preferredSkills": { "type": "array", "items": { "type": "string" } },
          "visual": { "type": "object" }
        }
      }
    }
  }
}
