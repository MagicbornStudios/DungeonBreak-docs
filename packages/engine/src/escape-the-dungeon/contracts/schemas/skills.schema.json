{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeonbreak.dev/schemas/skills.schema.json",
  "title": "SkillsPack",
  "description": "Content: skills (branches, unlock/use requirements, narrativeProfile, narrativeStatBonus). Referenced by archetypes and player.",
  "type": "object",
  "required": ["skills"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skillId", "name"],
        "properties": {
          "skillId": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "branch": { "type": "string" },
          "branchGroup": { "type": "string" },
          "exclusiveWith": { "type": "array", "items": { "type": "string" } },
          "unlockRadius": { "type": "number" },
          "narrativeProfile": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "unlockRequirements": { "type": "array" },
          "useRequirements": { "type": "array" },
          "narrativeStatBonus": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "visual": { "type": "object" }
        }
      }
    }
  }
}
