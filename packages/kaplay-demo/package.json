{
  "name": "@dungeonbreak/kaplay-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone KAPLAY single-file HTML game for Escape the Dungeon",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-standalone.ts",
    "capture:ui": "node scripts/capture-ui.mjs",
    "dev": "tsx scripts/build-standalone.ts --watch",
    "dev:standalone": "node scripts/dev-standalone.mjs",
    "perf:turns": "tsx scripts/perf-turns.ts",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dungeonbreak/engine": "link:../engine",
    "kaplay": "^3001.0.19",
    "lucide-static": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "^0.24.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
