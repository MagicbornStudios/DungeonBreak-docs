{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/vendor/repo-planner": ["../../vendor/repo-planner"],
      "@/vendor/repo-planner/*": ["../../vendor/repo-planner/*"],
      "@/components": ["../../vendor/repo-planner/components"],
      "@/components/*": ["../../vendor/repo-planner/components/*"],
      "@/lib": ["../../vendor/repo-planner/lib"],
      "@/lib/*": ["../../vendor/repo-planner/lib/*"],
      "@/planning-ui": ["./planning-ui"],
      "@/planning-ui/*": ["./planning-ui/*"],
      "@/hooks": ["./hooks"],
      "@/hooks/*": ["./hooks/*"],
      "@planning/lib": ["./lib"],
      "@planning/lib/*": ["./lib/*"],
      "clsx": ["./node_modules/clsx"],
      "clsx/*": ["./node_modules/clsx/*"],
      "tailwind-merge": ["./node_modules/tailwind-merge"],
      "tailwind-merge/*": ["./node_modules/tailwind-merge/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
