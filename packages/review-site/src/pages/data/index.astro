---
import fs from "node:fs";
import path from "node:path";
import { ContentPackExplorer } from "../../components/ContentPackExplorer.tsx";
import { InfoTip } from "../../components/InfoTip.tsx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadContentBundleSummary } from "../../lib/content-bundle-summary";
import { docsSiteRoot } from "../../lib/paths";

const summary = loadContentBundleSummary();
const bundleUrl = "../game/content-pack.bundle.v1.json";
const bundlePath = path.join(
	docsSiteRoot,
	"public",
	"game",
	"content-pack.bundle.v1.json",
);
let initialPacks: Record<string, unknown> = {};
if (fs.existsSync(bundlePath)) {
	const bundle = JSON.parse(fs.readFileSync(bundlePath, "utf8")) as {
		packs?: Record<string, unknown>;
	};
	initialPacks = bundle.packs ?? {};
}
---

<BaseLayout segment="data" title="Game data — DungeonBreak review hub">
	<header class="mb-8 space-y-3">
		<h1 class="text-3xl font-semibold tracking-tight">Game data &amp; schemas</h1>
		<p class="max-w-2xl text-muted-foreground">
			Browse each bundled collection below (read-only). The list is whatever the ingest
			pipeline put under <code class="rounded bg-muted px-1 py-0.5 text-xs">packs</code> in
			<code class="rounded bg-muted px-1 py-0.5 text-xs">content-pack.bundle.v1.json</code>.
		</p>
		<p class="max-w-2xl text-muted-foreground text-sm">
			<strong class="text-foreground">Note:</strong> missing “entity pack” or extra packs like{" "}
			<code class="rounded bg-muted px-0.5 text-xs">spaceVectors</code> are ingest/bundle
			questions, not review-site bugs — see{" "}
			<code class="rounded bg-muted px-1 py-0.5 text-xs">
				packages/review-site/CONTENT-BUNDLE-NOTES.md
			</code>{" "}
			in the repo.
		</p>
	</header>

	<section class="mb-8 rounded-xl border border-border bg-card p-6 shadow-lg">
		<div class="mb-4 flex flex-wrap items-center gap-2">
			<h2 class="text-lg font-semibold tracking-tight">Bundle snapshot</h2>
			<InfoTip client:load>
				Metadata from the same JSON file loaded in the explorer (build-time read + client
				fetch for the tree).
			</InfoTip>
		</div>
		{
			summary.ok ? (
				<dl class="grid gap-4 text-sm sm:grid-cols-2">
					<div>
						<dt class="text-muted-foreground">Schema version</dt>
						<dd class="font-mono text-foreground">{summary.schemaVersion ?? "—"}</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Generated</dt>
						<dd class="font-mono text-foreground">{summary.generatedAt ?? "—"}</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Engine</dt>
						<dd class="font-mono text-foreground">
							{summary.engineName ?? "—"} @ {summary.engineVersion ?? "—"}
						</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Model schemas (contentSchema)</dt>
						<dd class="font-mono text-foreground">
							{summary.modelSchemaCount ?? "—"}
						</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Content hashes</dt>
						<dd class="font-mono text-foreground">{summary.hashKeyCount ?? "—"} keys</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Collections in bundle</dt>
						<dd class="text-foreground">{summary.packKeys.length}</dd>
					</div>
				</dl>
			) : (
				<p class="text-destructive text-sm">{summary.error}</p>
			)
		}
		<p class="mt-6 text-muted-foreground text-sm">
			Raw JSON:{" "}
			<a class="text-primary underline-offset-4 hover:underline" href={bundleUrl}>
				{bundleUrl.replace("../", "")}
			</a>
		</p>
	</section>

	<section class="rounded-xl border border-border bg-card p-6 shadow-lg">
		<h2 class="mb-4 text-lg font-semibold tracking-tight">Collection explorer</h2>
		<ContentPackExplorer
			bundleUrl={bundleUrl}
			client:load
			initialPackKeys={summary.packKeys}
			initialPacks={initialPacks}
		/>
	</section>
</BaseLayout>
