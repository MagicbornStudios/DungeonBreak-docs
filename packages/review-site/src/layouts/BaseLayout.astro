---
import "../styles/global.css";
import LayoutShell from "../components/LayoutShell.tsx";
import type { ReviewTab } from "../lib/tab-href";

interface Props {
  title: string;
  segment: ReviewTab;
}

const { title, segment } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<meta content={Astro.generator} name="generator" />
		<title>{title}</title>
	</head>
	<body>
		<LayoutShell segment={segment}>
			<slot />
		</LayoutShell>
	</body>
</html>
