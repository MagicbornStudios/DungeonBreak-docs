# GitHub Pages project site: repo name as path segment (leading slash, no trailing slash).
# Example for https://user.github.io/DungeonBreak-docs/
# NEXT_PUBLIC_BASE_PATH=/DungeonBreak-docs

NEXT_PUBLIC_BASE_PATH=

# Main docs-site app URL (Payload, /play, asset explorer). Shown as outbound links on the overview.
# NEXT_PUBLIC_MAIN_APP_URL=https://your-deployment.example.com

NEXT_PUBLIC_MAIN_APP_URL=
