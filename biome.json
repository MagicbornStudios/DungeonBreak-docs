{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "package.json",
      "scripts/**/*",
      "packages/**/*",
      "!packages/**/dist/**/*",
      "!packages/engine/src/escape-the-dungeon/contracts/generated/**/*",
      "!vendor/**/*",
      "!plugins/**/*",
      "!generated/**/*",
      "!extracted/**/*",
      "!node_modules/**/*"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["packages/review-site/**/*.tsx", "packages/review-site/**/*.ts"],
      "linter": {
        "rules": {
          "style": { "useFilenamingConvention": "off" },
          "performance": { "noNamespaceImport": "off" }
        }
      }
    },
    {
      "includes": ["packages/review-site/**/*.astro"],
      "assist": {
        "actions": { "source": { "organizeImports": "off" } }
      },
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off" },
          "style": { "useFilenamingConvention": "off" }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveLinesPerFunction": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "useNamingConvention": "off"
      },
      "correctness": {
        "noUnusedVariables": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  }
}
